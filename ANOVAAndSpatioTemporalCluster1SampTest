# =============================================================================
# !!! First, I import libraries
# %%===========================================================================
import os
import numpy as np
import mne
from mne.channels import find_ch_adjacency
from mne.stats import (spatio_temporal_cluster_1samp_test, f_mway_rm, f_threshold_mway_rm, spatio_temporal_cluster_test)
from scipy import stats
import matplotlib.pyplot as plt
# =============================================================================

# =============================================================================
# I load/read the evokeds for the graph only
# %%===========================================================================
print("I load and read the evokeds")

General_Path = "E:/Ecrits/EEGSymptomProvocation/OCDEEG/MANUSCRIPTRAWDATA/"
Subjects_List = sorted(os.listdir(General_Path))

# Dictionnaire par sujet pour garantir l'appariement
Evokeds_by_subject = {}

for Subject in Subjects_List:
    Files_Path = os.path.join(General_Path, Subject, "Task")

    if not os.path.isdir(Files_Path):
        print(f"WARNING: dossier absent pour {Subject}: {Files_Path}")
        continue

    Files = sorted(os.listdir(Files_Path))

    neutral_evoked = None
    generic_evoked = None
    personalized_evoked = None

    # -------------------------------
    # Find matching files
    # -------------------------------
    neutral_files = []
    generic_files = []
    personalized_files = []
    
    for File in Files:
        if not File.endswith("-ave.fif"):
            continue
        
        if "Stim10" in File and "Baselined" in File:
            neutral_files.append(File)
            
        elif "Stim5" in File and "Baselined" in File:
            generic_files.append(File)
                
        elif "Stim14" in File and "Baselined" in File:
            personalized_files.append(File)

    # -------------------------------
    # Verify uniqueness
    # -------------------------------
    for Condition, Matches in [
            ("Neutral", neutral_files),
            ("Generic", generic_files),
            ("Personalized", personalized_files)
            ]:
        if len(Matches) != 1:
            raise RuntimeError(
                f"{Subject}: {len(Matches)} files found for {Condition}: {Matches}"
                )

    # -------------------------------
    # Load evokeds
    # -------------------------------
    neutral_evoked = mne.read_evokeds(
        os.path.join(Files_Path, neutral_files[0]),
        proj=False
        )[0]
    
    generic_evoked = mne.read_evokeds(
        os.path.join(Files_Path, generic_files[0]),
        proj=False
        )[0]
    
    personalized_evoked = mne.read_evokeds(
        os.path.join(Files_Path, personalized_files[0]),
        proj=False
        )[0]

    # garder seulement les sujets complets dans les 3 conditions
    if (neutral_evoked is not None and
        generic_evoked is not None and
        personalized_evoked is not None):

        Evokeds_by_subject[Subject] = {
            "Neutral": neutral_evoked,
            "Generic": generic_evoked,
            "Personalized": personalized_evoked
        }

    else:
        print(f"WARNING: sujet ignoré car condition manquante -> {Subject}")

Included_Subjects = sorted(Evokeds_by_subject.keys())

NeutralEvokeds = [Evokeds_by_subject[sub]["Neutral"] for sub in Included_Subjects]
GenericEvokeds = [Evokeds_by_subject[sub]["Generic"] for sub in Included_Subjects]
PersonalizedEvokeds = [Evokeds_by_subject[sub]["Personalized"] for sub in Included_Subjects]

print("Included subjects:")
print(Included_Subjects)
print(f"N included subjects = {len(Included_Subjects)}")

assert len(NeutralEvokeds) == len(GenericEvokeds) == len(PersonalizedEvokeds), \
    "Les listes de conditions n'ont pas la même longueur."

print("Subject order is guaranteed identical across the 3 conditions.")

ReferenceEvoked = NeutralEvokeds[0]

for Subject, Neu, Gen, Per in zip(
    Included_Subjects,
    NeutralEvokeds,
    GenericEvokeds,
    PersonalizedEvokeds
):
    for ConditionName, Evoked in [
        ("Neutral", Neu),
        ("Generic", Gen),
        ("Personalized", Per)
    ]:
        assert Evoked.ch_names == ReferenceEvoked.ch_names, (
            f"Channel names/order mismatch: {Subject}, {ConditionName}"
        )

        assert np.array_equal(Evoked.times, ReferenceEvoked.times), (
            f"Time vector mismatch: {Subject}, {ConditionName}"
        )

        assert Evoked.info["sfreq"] == ReferenceEvoked.info["sfreq"], (
            f"Sampling-frequency mismatch: {Subject}, {ConditionName}"
        )

print("All evokeds have identical channels, channel order and times.")
# =============================================================================

# =============================================================================
# OMNIBUS 3-CONDITION CLUSTER-BASED RM-ANOVA
# %%===========================================================================
print("I do the omnibus 3-condition repeated-measures ANOVA")

Pick = ["eeg"]   # ou Pick = "eeg"

alpha_cluster = 0.05
n_permutations = 5000
seed = 1

print("Included subjects used for ANOVA:")
print(Included_Subjects)

n_neu = len(NeutralEvokeds)
n_gen = len(GenericEvokeds)
n_per = len(PersonalizedEvokeds)

print(f"N Neutral = {n_neu}")
print(f"N Generic = {n_gen}")
print(f"N Personalized = {n_per}")

assert n_neu == n_gen == n_per, \
    "Les trois conditions n'ont pas le même nombre de sujets."

X_neu = np.array([ev.copy().pick(Pick).data for ev in NeutralEvokeds])
X_gen = np.array([ev.copy().pick(Pick).data for ev in GenericEvokeds])
X_per = np.array([ev.copy().pick(Pick).data for ev in PersonalizedEvokeds])

print("Raw shapes:")
print("X_neu =", X_neu.shape)
print("X_gen =", X_gen.shape)
print("X_per =", X_per.shape)

ev_template = NeutralEvokeds[0].copy().pick(Pick)
info_pick = ev_template.info
Adjacency, ch_names = find_ch_adjacency(info_pick, ch_type="eeg")
print("Adjacency shape =", Adjacency.shape)

X_neu = np.transpose(X_neu, (0, 2, 1))
X_gen = np.transpose(X_gen, (0, 2, 1))
X_per = np.transpose(X_per, (0, 2, 1))

print("Shapes for MNE:")
print("X_neu =", X_neu.shape)
print("X_gen =", X_gen.shape)
print("X_per =", X_per.shape)

def stat_fun(*args):
    data = np.swapaxes(args, 1, 0)
    # shape -> (n_subjects, n_conditions, n_times, n_channels)

    return f_mway_rm(
        data,
        factor_levels=[3],
        effects='A',
        correction=False,
        return_pvals=False
    )[0]

f_threshold = f_threshold_mway_rm(
    n_subjects=n_neu,
    factor_levels=[3],
    effects="A",
    pvalue=0.05
)

F_obs, clusters, p_values, H0 = spatio_temporal_cluster_test(
    [X_neu, X_gen, X_per],
    stat_fun=stat_fun,
    adjacency=Adjacency,
    n_permutations=n_permutations,
    threshold=f_threshold,
    tail=1,
    n_jobs=-1,
    seed=seed,
    out_type="mask",
    verbose=True
)
sig_mask_anova = np.zeros(F_obs.shape, dtype=bool)  # (n_times, n_channels)
for cl_mask, p in zip(clusters, p_values):
    if p < alpha_cluster:
        sig_mask_anova |= cl_mask

times_anova = ev_template.times
ch_names_anova = np.array(ev_template.ch_names)

t_peak_all_anova, ch_peak_all_anova = np.unravel_index(
    np.argmax(F_obs), F_obs.shape
)

print("Min cluster p-value (ANOVA) =", float(np.min(p_values)) if len(p_values) else np.nan)
print("Number of significant clusters (ANOVA) =", int(np.sum(p_values < alpha_cluster)) if len(p_values) else 0)
print("Number of significant (time, channel) points (ANOVA) =", int(sig_mask_anova.sum()))
# =============================================================================

# =============================================================================
# SUMMARY ANOVA
# %%===========================================================================
print("Summary of omnibus ANOVA")

sig_times_anova = np.any(sig_mask_anova, axis=1)
t_inds_all_anova = np.where(sig_times_anova)[0]

if len(t_inds_all_anova) == 0:
    print("No significant cluster-corrected omnibus effect at alpha =", alpha_cluster)
else:
    tmin_sig_anova = times_anova[t_inds_all_anova.min()]
    tmax_sig_anova = times_anova[t_inds_all_anova.max()]
    print(f"Significant omnibus effect present between {tmin_sig_anova:.3f} and {tmax_sig_anova:.3f} s (at least one channel).")

    masked_F = F_obs * sig_mask_anova
    t_peak_anova, ch_peak_anova = np.unravel_index(np.argmax(masked_F), masked_F.shape)

    cluster_at_peak_anova = None
    p_at_peak_anova = None

    for cl_mask, p in zip(clusters, p_values):
        if p < alpha_cluster and cl_mask[t_peak_anova, ch_peak_anova]:
            cluster_at_peak_anova = cl_mask
            p_at_peak_anova = float(p)
            break

    if cluster_at_peak_anova is None:
        print("WARNING: Peak is in sig_mask_anova but no significant cluster was found containing it.")
    else:
        ch_in_cluster_anova = np.where(np.any(cluster_at_peak_anova, axis=0))[0]
        ch_names_cluster_anova = ch_names_anova[ch_in_cluster_anova]

        t_in_cluster_anova = np.where(np.any(cluster_at_peak_anova, axis=1))[0]
        tmin_c_anova = times_anova[t_in_cluster_anova.min()]
        tmax_c_anova = times_anova[t_in_cluster_anova.max()]

        print("Channels in significant ANOVA cluster (peak cluster):")
        print(", ".join(ch_names_cluster_anova))
        print(f"Number of channels in ANOVA cluster: {len(ch_names_cluster_anova)}")
        print(f"ANOVA cluster time window: {tmin_c_anova:.3f}–{tmax_c_anova:.3f} s")
        print(
            f"ANOVA peak at t={times_anova[t_peak_anova]:.3f}s, "
            f"channel={ch_names_anova[ch_peak_anova]}, "
            f"F={F_obs[t_peak_anova, ch_peak_anova]:.2f}, "
            f"cluster p={p_at_peak_anova:.3g}"
        )
# =============================================================================

# =============================================================================
# Cluster-based permutation test (classique, sans TFCE) + masque significatif
# %%===========================================================================
print("I do the statistics")

Evoked1 = PersonalizedEvokeds          # TO ADAPT
Evoked2 = GenericEvokeds               # TO ADAPT (ou PersonalizedEvokeds)

# Pick = "eeg"  # pour toutes les électrodes EEG
Pick = ["eeg"]

alpha_cluster_forming = 0.05  
alpha_cluster = 0.05           
n_permutations = 5000
tail = 0                    
seed = 1

X = []
for Ev1, Ev2 in zip(Evoked1, Evoked2):
    D1 = Ev1.copy().pick(Pick)
    D2 = Ev2.copy().pick(Pick)
    X.append(D1.data - D2.data)

X = np.array(X)
print("X shape (n_subjects, n_channels, n_times) =", X.shape)

ev_template = Evoked1[0].copy().pick(Pick)
info_pick = ev_template.info
Adjacency, ch_names = find_ch_adjacency(info_pick, ch_type="eeg")
print("Adjacency shape =", Adjacency.shape)

X = np.transpose(X, (0, 2, 1))
print("X shape for MNE (n_subjects, n_times, n_channels) =", X.shape)

n_subjects = X.shape[0]
df = n_subjects - 1
if tail == 0:
    t_threshold = stats.t.ppf(1 - alpha_cluster_forming / 2, df)  # two-sided
else:
    t_threshold = stats.t.ppf(1 - alpha_cluster_forming, df)      # one-sided
print(f"Cluster-forming threshold t = {t_threshold:.3f} (df={df}, alpha={alpha_cluster_forming}, tail={tail})")

T_obs, clusters, p_values, H0 = spatio_temporal_cluster_1samp_test(
    X,
    adjacency=Adjacency,
    n_permutations=n_permutations,
    threshold=t_threshold,   # <-- PAS TFCE
    tail=tail,
    n_jobs=-1,
    seed=seed,
    out_type="mask",
    verbose=True
)

sig_mask = np.zeros(T_obs.shape, dtype=bool)  # (n_times, n_channels)
for cl_mask, p in zip(clusters, p_values):
    if p < alpha_cluster:
        sig_mask |= cl_mask

times = ev_template.times
ch_names = np.array(ev_template.ch_names)

t_peak_all, ch_peak_all = np.unravel_index(np.argmax(np.abs(T_obs)), T_obs.shape)

print("Min cluster p-value =", float(np.min(p_values)) if len(p_values) else np.nan)
print("Number of significant clusters =", int(np.sum(p_values < alpha_cluster)) if len(p_values) else 0)
print("Number of significant (time, channel) points =", int(sig_mask.sum()))
print("\nAll significant cluster p-values:")
for i, p in enumerate(p_values):
    if p < alpha_cluster:
        print(f"Cluster {i}: p = {p:.4f}")
# =============================================================================

# =============================================================================
# ELECTRODE RANKING FOR EACH SIGNIFICANT CLUSTER
# %%===========================================================================
print("Ranking electrodes for each significant cluster")

ch_names = np.array(ev_template.ch_names)

sig_cluster_indices = np.where(p_values < alpha_cluster)[0]

if len(sig_cluster_indices) == 0:
    print("No significant clusters found.")
else:
    print(f"Number of significant clusters = {len(sig_cluster_indices)}")

    for k, cl_idx in enumerate(sig_cluster_indices, start=1):
        cl_mask = clusters[cl_idx]
        p_cl = float(p_values[cl_idx])

        n_timepoints_cluster = cl_mask.sum(axis=0)

        abs_t_cluster = np.zeros(len(ch_names), dtype=float)
        for ch_i in range(len(ch_names)):
            abs_t_cluster[ch_i] = np.abs(T_obs[cl_mask[:, ch_i], ch_i]).sum()

        t_inds = np.where(np.any(cl_mask, axis=1))[0]
        tmin_cl = times[t_inds.min()]
        tmax_cl = times[t_inds.max()]

        sort_idx = np.lexsort((
            -abs_t_cluster,
            -n_timepoints_cluster
        ))

        print("\n" + "="*70)
        print(f"\nSignificant cluster #{k}")
        print(f"Cluster index: {cl_idx}")
        print(f"Cluster p-value: {p_cl:.4f}")
        print(f"Time window: {tmin_cl:.3f}–{tmax_cl:.3f} s")
        print("Rank | Channel | TimePtsInCluster | SumAbsT")

        rank = 1
        for idx in sort_idx:
            if n_timepoints_cluster[idx] > 0:
                print(
                    f"{rank:>4} | "
                    f"{ch_names[idx]:>7} | "
                    f"{n_timepoints_cluster[idx]:>16d} | "
                    f"{abs_t_cluster[idx]:>7.2f}"
                )
                rank += 1
# =============================================================================

# =============================================================================
# SUMMARY OF ALL SIGNIFICANT CLUSTERS
# %%===========================================================================

sig_cluster_inds = np.where(p_values < alpha_cluster)[0]

print(f"Number of significant clusters = {len(sig_cluster_inds)}")

for i, cl_idx in enumerate(sig_cluster_inds, start=1):
    cl_mask = clusters[cl_idx]
    p = p_values[cl_idx]

    # time window
    t_in_cluster = np.where(np.any(cl_mask, axis=1))[0]
    tmin_c = times[t_in_cluster.min()]
    tmax_c = times[t_in_cluster.max()]

    ch_in_cluster = np.where(np.any(cl_mask, axis=0))[0]
    ch_names_cluster = ch_names[ch_in_cluster]

    masked_absT_cluster = np.abs(T_obs) * cl_mask
    t_peak_c, ch_peak_c = np.unravel_index(
        np.argmax(masked_absT_cluster),
        masked_absT_cluster.shape
    )

    print("\n" + "="*80)
    print(f"Significant cluster {i}")
    print(f"Cluster index: {cl_idx}")
    print(f"Cluster p-value: {p:.4f}")
    print(f"Time window: {tmin_c:.3f}–{tmax_c:.3f} s")
    print(f"Number of channels: {len(ch_names_cluster)}")
    print("Channels:")
    print(", ".join(ch_names_cluster))
    print(
        f"Peak: t={times[t_peak_c]:.3f}s, "
        f"channel={ch_names[ch_peak_c]}, "
        f"t={T_obs[t_peak_c, ch_peak_c]:.2f}, "
        f"|t|={abs(T_obs[t_peak_c, ch_peak_c]):.2f}"
    )
# =============================================================================

# =============================================================================
# 5) PLOT: Une T-map séparée pour chaque cluster significatif
# %%===========================================================================
print("Plot: one T-map per significant cluster")

from matplotlib.patches import Rectangle
from matplotlib.collections import PatchCollection

sig_cluster_inds = np.where(p_values < alpha_cluster)[0]

# ============================================================
# CAS 1 : AUCUN CLUSTER → fallback = T-map globale au pic
# ============================================================
if len(sig_cluster_inds) == 0:

    print("No significant clusters → plotting global T-map at peak")

    t_peak_all, ch_peak_all = np.unravel_index(
        np.argmax(np.abs(T_obs)),
        T_obs.shape
    )

    fig, ax = plt.subplots(figsize=(12, 8))

    dt = float(np.median(np.diff(times))) if len(times) > 1 else 0.0
    t_edges = np.r_[times[0] - dt/2, times + dt/2]
    y_edges = np.arange(len(ch_names) + 1)

    extent = [t_edges[0], t_edges[-1], y_edges[0], y_edges[-1]]

    vmax = np.max(np.abs(T_obs))
    vmin, vmax = (-vmax, vmax) if vmax > 0 else (None, None)

    im = ax.imshow(
        T_obs.T,
        aspect="auto",
        origin="lower",
        extent=extent,
        interpolation="nearest",
        cmap="RdBu_r",
        vmin=vmin,
        vmax=vmax
    )

    fig.colorbar(im, ax=ax, label="t")

    ax.plot(times[t_peak_all], ch_peak_all + 0.5, "ko")

    xt = np.linspace(times[0], times[-1], 6)
    ax.set_xticks(xt)
    ax.set_xticklabels([f"{x:.2f}" for x in xt])

    if len(ch_names) <= 64:
        ax.set_yticks(np.arange(len(ch_names)) + 0.5)
        ax.set_yticklabels(ch_names)
    else:
        step = max(1, len(ch_names) // 32)
        idx = np.arange(0, len(ch_names), step)
        ax.set_yticks(idx + 0.5)
        ax.set_yticklabels(np.array(ch_names)[idx])

    ax.set_xlim(t_edges[0], t_edges[-1])
    ax.set_ylim(0, len(ch_names))

    ax.axvline(0, color="k", linestyle="--", linewidth=1)

    ax.set_xlabel("Temps (s)")
    ax.set_ylabel("Électrodes")

    ax.set_title(
        f"No significant cluster\n"
        f"Global peak: t={times[t_peak_all]:.3f}s, "
        f"{ch_names[ch_peak_all]}, "
        f"t={T_obs[t_peak_all, ch_peak_all]:.2f}"
    )

    fig.tight_layout()
    plt.show()

# ============================================================
# CAS 2 : CLUSTERS PRÉSENTS → code habituel
# ============================================================
else:
    for cluster_number, cl_idx in enumerate(sig_cluster_inds, start=1):

        cl_mask = clusters[cl_idx]
        p_cl = float(p_values[cl_idx])

        t_in_cluster = np.where(np.any(cl_mask, axis=1))[0]
        tmin_cl = times[t_in_cluster.min()]
        tmax_cl = times[t_in_cluster.max()]

        masked_absT_cluster = np.abs(T_obs) * cl_mask
        t_peak_c, ch_peak_c = np.unravel_index(
            np.argmax(masked_absT_cluster),
            masked_absT_cluster.shape
        )

        print(
            f"Plotting cluster {cluster_number} "
            f"(index={cl_idx}, p={p_cl:.4f}, "
            f"{tmin_cl:.3f}–{tmax_cl:.3f}s)"
        )

        fig, ax = plt.subplots(figsize=(12, 8))

        dt = float(np.median(np.diff(times))) if len(times) > 1 else 0.0
        t_edges = np.r_[times[0] - dt/2, times + dt/2]
        y_edges = np.arange(len(ch_names) + 1)

        extent = [t_edges[0], t_edges[-1], y_edges[0], y_edges[-1]]

        vmax = np.max(np.abs(T_obs))
        vmin, vmax = (-vmax, vmax) if vmax > 0 else (None, None)

        im = ax.imshow(
            T_obs.T,
            aspect="auto",
            origin="lower",
            extent=extent,
            interpolation="nearest",
            cmap="RdBu_r",
            vmin=vmin,
            vmax=vmax
        )

        fig.colorbar(im, ax=ax, label="t")

        sig = cl_mask.T
        n_ch, n_t = sig.shape

        patches = []

        for ch_i in range(n_ch):
            s = sig[ch_i, :]

            changes = np.diff(s.astype(int))
            starts = list(np.where(changes == 1)[0] + 1)
            ends = list(np.where(changes == -1)[0])

            if s[0]:
                starts = [0] + starts
            if s[-1]:
                ends = ends + [n_t - 1]

            for t0_i, t1_i in zip(starts, ends):
                x0 = t_edges[t0_i]
                x1 = t_edges[t1_i + 1]
                y0 = y_edges[ch_i]

                rect = Rectangle((x0, y0), x1 - x0, 1.0)
                patches.append(rect)

        if len(patches) > 0:
            pc = PatchCollection(
                patches,
                facecolor="none",
                edgecolor="k",
                linewidth=1.2
            )
            ax.add_collection(pc)

        xt = np.linspace(times[0], times[-1], 6)
        ax.set_xticks(xt)
        ax.set_xticklabels([f"{x:.2f}" for x in xt])

        if len(ch_names) <= 64:
            ax.set_yticks(np.arange(len(ch_names)) + 0.5)
            ax.set_yticklabels(ch_names)
        else:
            step = max(1, len(ch_names) // 32)
            idx = np.arange(0, len(ch_names), step)
            ax.set_yticks(idx + 0.5)
            ax.set_yticklabels(np.array(ch_names)[idx])

        ax.set_xlim(t_edges[0], t_edges[-1])
        ax.set_ylim(0, len(ch_names))

        ax.axvline(0, color="k", linestyle="--", linewidth=1)

        ax.set_xlabel("Temps (s)")
        ax.set_ylabel("Électrodes")

        ax.set_title(
            f"Cluster {cluster_number} "
            f"(index={cl_idx}, p={p_cl:.4f}) | "
            f"{tmin_cl:.3f}–{tmax_cl:.3f}s | "
            f"peak: {times[t_peak_c]:.3f}s, {ch_names[ch_peak_c]}, "
            f"t={T_obs[t_peak_c, ch_peak_c]:.2f}"
        )

        fig.tight_layout()
        plt.show()
# =============================================================================

# =============================================================================
# 6) TOPOMAPS PAR CLUSTER SIGNIFICATIF
#    A) topomap au pic du cluster
#    B) topomap moyenne sur la fenêtre temporelle du cluster
# %%===========================================================================
print("Plot: topomaps for each significant cluster")

sig_cluster_inds = np.where(p_values < alpha_cluster)[0]

if len(sig_cluster_inds) == 0:
    print("No significant clusters to plot as topomaps.")

    data_topo = T_obs[t_peak_all, :]

    vmax = np.max(np.abs(data_topo))
    vlim = (-vmax, vmax) if vmax > 0 else (None, None)

    fig, ax = plt.subplots(figsize=(6, 6))

    im, _ = mne.viz.plot_topomap(
        data_topo,
        ev_template.info,
        axes=ax,
        show=False,
        cmap="RdBu_r",
        vlim=vlim,
        contours=6,
        sensors=True
    )

    fig.colorbar(im, ax=ax, shrink=0.75, label="t")
    ax.set_title(
        f"Topomap au pic global\n"
        f"t={times[t_peak_all]*1000:.0f} ms | pas de cluster significatif"
    )

    plt.tight_layout()
    plt.show()

else:
    for cluster_number, cl_idx in enumerate(sig_cluster_inds, start=1):

        cl_mask = clusters[cl_idx]  # shape = (n_times, n_channels)
        p_cl = float(p_values[cl_idx])

        t_in_cluster = np.where(np.any(cl_mask, axis=1))[0]
