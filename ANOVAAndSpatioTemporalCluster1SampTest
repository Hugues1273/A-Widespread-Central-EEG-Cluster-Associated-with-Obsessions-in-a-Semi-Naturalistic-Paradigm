# 10) PLOT: T-map automatique pour chaque cluster significatif
# %%===========================================================================
print("Plot: T-map for each significant cluster")

from matplotlib.patches import Rectangle
from matplotlib.collections import PatchCollection

sig_cluster_inds = np.where(p_values < alpha_cluster)[0]

if len(sig_cluster_inds) == 0:
    print("No significant clusters to plot.")

else:
    for cluster_number, cl_idx in enumerate(sig_cluster_inds, start=1):

        cl_mask = clusters[cl_idx]  # shape = (n_times, n_channels)
        p_cl = float(p_values[cl_idx])

        t_in_cluster = np.where(np.any(cl_mask, axis=1))[0]
        tmin_plot = times[t_in_cluster.min()]
        tmax_plot = times[t_in_cluster.max()]

        ch_in_cluster = np.where(np.any(cl_mask, axis=0))[0]
        selected_channels = list(ch_names[ch_in_cluster])

        print("\n" + "="*80)
        print(
            f"Cluster {cluster_number} | index={cl_idx} | "
            f"p={p_cl:.4f} | {tmin_plot:.3f}–{tmax_plot:.3f} s"
        )
        print("Channels:")
        print(", ".join(selected_channels))

        time_mask = (times >= tmin_plot) & (times <= tmax_plot)
        time_indices = np.where(time_mask)[0]
        times_sel = times[time_indices]

        T_sel = T_obs[time_indices][:, ch_in_cluster]
        sig_sel = cl_mask[time_indices][:, ch_in_cluster]

        dt = float(np.median(np.diff(times_sel))) if len(times_sel) > 1 else 0.0
        t_edges = np.r_[times_sel[0] - dt / 2, times_sel + dt / 2]

        y_edges = np.arange(len(selected_channels) + 1)

        fig_height = max(4, 0.25 * len(selected_channels))
        fig_width = max(8, 2.5 * (tmax_plot - tmin_plot) / 0.1)

        fig, ax = plt.subplots(figsize=(fig_width, fig_height))

        extent = [t_edges[0], t_edges[-1], y_edges[0], y_edges[-1]]

        vmax = np.max(np.abs(T_sel))
        vmin, vmax_plot = (-vmax, vmax) if vmax > 0 else (None, None)

        im = ax.imshow(
            T_sel.T,
            aspect="auto",
            origin="lower",
            extent=extent,
            interpolation="nearest",
            cmap="RdBu_r",
            vmin=vmin,
            vmax=vmax_plot
        )

        fig.colorbar(im, ax=ax, label="t")

        sig = sig_sel.T  # shape = (n_channels, n_times)
        n_ch, n_t = sig.shape

        patches = []

        for ch_i in range(n_ch):
            s = sig[ch_i, :]

            changes = np.diff(s.astype(int))
            starts = list(np.where(changes == 1)[0] + 1)
            ends = list(np.where(changes == -1)[0])

            if s[0]:
                starts = [0] + starts
            if s[-1]:
                ends = ends + [n_t - 1]

            for t0_i, t1_i in zip(starts, ends):
                x0 = t_edges[t0_i]
                x1 = t_edges[t1_i + 1]
                y0 = y_edges[ch_i]

                rect = Rectangle((x0, y0), x1 - x0, 1.0)
                patches.append(rect)

        if len(patches) > 0:
            pc = PatchCollection(
                patches,
                facecolor="none",
                edgecolor="k",
                linewidth=1.5
            )
            ax.add_collection(pc)

        n_xticks = min(6, max(2, len(times_sel)))
        xt = np.linspace(times_sel[0], times_sel[-1], n_xticks)
        ax.set_xticks(xt)
        ax.set_xticklabels([f"{x:.3f}" for x in xt])

        ax.set_yticks(np.arange(len(selected_channels)) + 0.5)
        ax.set_yticklabels(selected_channels)

        ax.set_xlim(t_edges[0], t_edges[-1])
        ax.set_ylim(0, len(selected_channels))

        ax.axvline(0, color="k", linestyle="--", linewidth=1)

        ax.set_xlabel("Time (s)")
        ax.set_ylabel("Electrodes")

        ax.set_title(
            f"T-map cluster {cluster_number}\n"
            f"index={cl_idx} | p={p_cl:.4f} | "
            f"{tmin_plot:.3f}–{tmax_plot:.3f} s | "
            f"n_ch={len(selected_channels)}"
        )

        fig.tight_layout()
        plt.show()
