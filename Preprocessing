# =============================================================================
# 7) ICA #1 : BEFORE INTERPOLATION - BAD CHANNEL IDENTIFICATION
# %%===========================================================================

ICA_1 = ICA(
    n_components=ICA_N_COMPONENTS,
    method=ICA_METHOD,
    random_state=ICA_RANDOM_STATE,
    max_iter=ICA_MAX_ITER,
    fit_params=ICA_FIT_PARAMS
)
ICA_1.fit(Epochs)

FigICA1 = ICA_1.plot_components(
    picks=range(30),
    nrows=5,
    ncols=6,
    show=False
    )

if isinstance(FigICA1, list):
    for i, Fig in enumerate(FigICA1):
        Fig.savefig(
            os.path.join(SaveRoot, f"{Subject}_ICA1_before_interpolation_page_{i+1}.png"),
            dpi=300,
            bbox_inches="tight"
        )
else:
    FigICA1.savefig(
        os.path.join(SaveRoot, f"{Subject}_ICA1_before_interpolation.png"),
        dpi=300,
        bbox_inches="tight"
    )

ICA_1.save(
    os.path.join(SaveRoot, f"{Subject}_ICA1_before_interpolation-ica.fif"),
    overwrite=True
)

# =============================================================================
# 8) CHOOSE CHANNELS TO INTERPOLATE AFTER LOOKING AT ICA #1
# %%===========================================================================

CHANNELS_TO_INTERPOLATE = [] # TO FILL

Epochs_Interp = Epochs.copy()

ExistingChannelsToInterpolate = [
    ch for ch in CHANNELS_TO_INTERPOLATE if ch in Epochs_Interp.ch_names
]

Epochs_Interp.info["bads"] = list(
    set(Epochs_Interp.info["bads"] + ExistingChannelsToInterpolate)
)

if len(ExistingChannelsToInterpolate) > 0:
    Epochs_Interp.interpolate_bads(reset_bads=True, verbose=False)

print("Interpolated channels:", ExistingChannelsToInterpolate)

# =============================================================================
# 9) ICA #2 : AFTER INTERPOLATION
# %%===========================================================================

ICA_2 = ICA(
    n_components=ICA_N_COMPONENTS,
    method=ICA_METHOD,
    random_state=ICA_RANDOM_STATE,
    max_iter=ICA_MAX_ITER,
    fit_params=ICA_FIT_PARAMS
)
ICA_2.fit(Epochs_Interp)

FigICA2 = ICA_2.plot_components(
    picks=range(30),
    nrows=5,
    ncols=6,
    show=False
    )

if isinstance(FigICA2, list):
    for i, Fig in enumerate(FigICA2):
        Fig.savefig(
            os.path.join(SaveRoot, f"{Subject}_ICA2_after_interpolation_page_{i+1}.png"),
            dpi=300,
            bbox_inches="tight"
        )
else:
    FigICA2.savefig(
        os.path.join(SaveRoot, f"{Subject}_ICA2_after_interpolation.png"),
        dpi=300,
        bbox_inches="tight"
    )

ICA_2.save(
    os.path.join(SaveRoot, f"{Subject}_ICA2_after_interpolation-ica.fif"),
    overwrite=True
)

# =============================================================================
# 10) SAVE INDIVIDUAL COMPONENT PROPERTIES FOR ICA #2
# %%===========================================================================

ICA2_Properties_Figure = ICA_2.plot_properties(
    Epochs_Interp,
    picks=list(range(0, ICA_N_COMPONENTS, 1)),
    show=False
)

for Index, Fig in enumerate(ICA2_Properties_Figure):
    Fig.savefig(
        os.path.join(
            SaveRoot,
            f"{Subject}_ICA2_component_properties_{Index + 1}.pdf"
        ),
        dpi=300,
        bbox_inches="tight"
    )

# =============================================================================
# 11) ICLABEL ON ICA #2
# %%===========================================================================

IcaLabels_2 = label_components(Epochs_Interp, ICA_2, method="iclabel")
print(IcaLabels_2["labels"])

ExcludedIndicesAuto_2 = []
for i in range(0, len(IcaLabels_2["labels"])):
    if IcaLabels_2["labels"][i] == "brain":
        continue
    elif IcaLabels_2["labels"][i] == "other":
        continue
    else:
        ExcludedIndicesAuto_2.append(i)

print("Auto-suggested bad ICA components at step 2:", ExcludedIndicesAuto_2)

# =============================================================================
# 12) MANUAL EXCLUSION #1 AFTER ICA #2
# %%===========================================================================

MANUAL_EXCLUDE_STEP2 = [] # TO FILL

InvalidManualExclude2 = [
    idx for idx in MANUAL_EXCLUDE_STEP2
    if idx < 0 or idx >= ICA_2.n_components_
]
if len(InvalidManualExclude2) > 0:
    raise ValueError(
        f"Invalid ICA indices in MANUAL_EXCLUDE_STEP2: {InvalidManualExclude2}"
    )

ICA_2.exclude = MANUAL_EXCLUDE_STEP2
print("Manual exclusions at step 2:", ICA_2.exclude)

if len(MANUAL_EXCLUDE_STEP2) > 0:
    FigExcludedStep2 = ICA_2.plot_components(
        picks=MANUAL_EXCLUDE_STEP2,
        show=False
