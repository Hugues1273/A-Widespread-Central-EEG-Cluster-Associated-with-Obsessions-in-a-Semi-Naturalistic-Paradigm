# 13) APPLY ICA #2
# %%===========================================================================

Epochs_After_ICA2 = Epochs_Interp.copy()
ICA_2.apply(Epochs_After_ICA2)

print("ICA #2 applied")

# =============================================================================
# 14) ICA #3 : AFTER FIRST MANUAL CLEANING
# %%===========================================================================

ICA_3 = ICA(
    n_components=ICA_N_COMPONENTS,
    method=ICA_METHOD,
    random_state=ICA_RANDOM_STATE,
    max_iter=ICA_MAX_ITER,
    fit_params=ICA_FIT_PARAMS
)
ICA_3.fit(Epochs_After_ICA2)

FigICA3 = ICA_3.plot_components(
    picks=range(30),
    nrows=5,
    ncols=6,
    show=False
    )

if isinstance(FigICA3, list):
    for i, Fig in enumerate(FigICA3):
        Fig.savefig(
            os.path.join(SaveRoot, f"{Subject}_ICA3_before_find_bads_eog_page_{i+1}.png"),
            dpi=300,
            bbox_inches="tight"
        )
else:
    FigICA3.savefig(
        os.path.join(SaveRoot, f"{Subject}_ICA3_before_find_bads_eog.png"),
        dpi=300,
        bbox_inches="tight"
    )

ICA_3.save(
    os.path.join(SaveRoot, f"{Subject}_ICA3_before_find_bads_eog-ica.fif"),
    overwrite=True
)

# =============================================================================
# 15) FIND_BADS_EOG ON ICA #3
# %%===========================================================================

EOG_Components = []

for EOGChannel in ["Fp1", "Fp2"]:
    if EOGChannel in Epochs_After_ICA2.ch_names:
        inds_eog, scores_eog = ICA_3.find_bads_eog(
            Epochs_After_ICA2,
            ch_name=EOGChannel
        )
        print(f"{EOGChannel} suspects:", inds_eog)
        EOG_Components.extend(inds_eog)

EOG_Components = sorted(list(set(EOG_Components)))
print("Auto-detected EOG components:", EOG_Components)

# =============================================================================
# 16) PLOT FOR SELECTING LAST BAD COMPONENTS
# %%===========================================================================
