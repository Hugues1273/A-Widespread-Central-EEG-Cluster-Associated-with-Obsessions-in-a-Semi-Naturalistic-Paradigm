# %%===========================================================================
Subject = "ID"
FolderPath = f"D:/EEGData/{Subject}/Actichamp64/"
Index = "000001"
FilePath = FolderPath + Subject + Index + ".vhdr"

SaveRoot = f"E:/Ecrits/EEGSymptomProvocation/OCDEEG/MANUSCRIPTRAWDATA/{Subject}/RestingState/"

LFreq = 1
HFreq = 30
Tmin = 30
Tmax = 180
TargetSFreq = 250

ICA_N_COMPONENTS = 30
ICA_METHOD = "picard"
ICA_RANDOM_STATE = 97
ICA_MAX_ITER = "auto"
ICA_FIT_PARAMS = None

Event_ID = {
    "Stimulus/S  4": 4,
    "Stimulus/S 24": 24,
    "Stimulus/S 13": 13,
    "Stimulus/S 23": 23
}

ERRORSubjects = ["ID", "ID"]

PRISMESubjects = [
    "ID", "ID", "ID", "IDL",
    "ID", "ID", "ID", "ID",
    "ID", "ID", "ID", "ID"
]

# =============================================================================
# 1) LOAD RAW DATA
# %%===========================================================================

RawData = mne.io.read_raw_brainvision(FilePath, preload=True)
print("Raw loaded")

# =============================================================================
# 2) SHAPING RAW DATA
# %%===========================================================================

for Patient in ERRORSubjects:
    if Patient in Subject:
        if Patient == "LucileBENOIST":
            RawData.rename_channels({"AF1": "AF7", "AF2": "AF3"})
        elif Patient == "LucasLABEYRIE":
            RawData.rename_channels({"CZ": "Cz", "EOGD": "EOGR"})

for Patient in PRISMESubjects:
    if Patient in Subject:
        RawData.drop_channels([
            'EOGL', 'EOGR', '68', '69', '70', '71', '72', '73', '74', '75',
            '76', '77', '78', '79', '80', '81', '82', '83', '84', '85',
            '86', '87', '88', '89', '90', '91', '92', '93', '94', '95', '96'
        ])
        RawData.set_channel_types({"EKG": "ecg"})

mne.add_reference_channels(RawData, "Fz", copy=False)

RawData.set_montage("easycap-M1", on_missing="raise")

FigSensors = RawData.plot_sensors(show_names=True)
FigSensors.savefig(
    os.path.join(SaveRoot, f"{Subject}_sensors.png"),
    dpi=300,
    bbox_inches="tight"
)

RawData.set_eeg_reference(["CPz"], projection=False)

FigRaw = RawData.plot(title="Original Signal", show=False)

# =============================================================================
# 3) REST RE-REFERENCE
# %%===========================================================================

Sphere = mne.make_sphere_model("auto", "auto", RawData.info)
Source = mne.setup_volume_source_space(
    sphere=Sphere,
    exclude=30.0,
    pos=5.0,
    mri=None
)
Forward = mne.make_forward_solution(
    RawData.info,
    trans=None,
    src=Source,
    bem=Sphere
)

RawData_RESTed = RawData.copy().set_eeg_reference("REST", forward=Forward)

# =============================================================================
# 4) FILTERING
# %%===========================================================================

RawData_HighLowPassed = RawData_RESTed.filter(l_freq=LFreq, h_freq=HFreq)

RawData_HighLowPassed.resample(TargetSFreq, npad="auto")
print(f"Data resampled to {TargetSFreq} Hz")

FigFiltered = RawData_HighLowPassed.plot(
    title="High- and Low-passed Signal",
    show=False
)


if HFreq < 50:
    RawData_Notched = RawData_HighLowPassed
else:
    RawData_Notched = RawData_HighLowPassed.notch_filter(
        freqs=[50],
        picks="data",
        method="spectrum_fit"
    )

FigNotched = RawData_Notched.plot(title="Notched Signal", show=False)

# =============================================================================
# 5) EPOCHING
# %%===========================================================================

Events_from_annot, Event_dict = mne.events_from_annotations(RawData_Notched)

Epochs = mne.Epochs(
    RawData_Notched,
    events=Events_from_annot,
    tmin=Tmin,
    tmax=Tmax,
    baseline=None,
    preload=True,
    event_id=Event_ID
)

FigEpochs = Epochs.plot(show=False)

