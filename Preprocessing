    )

# =============================================================================
# 17) MANUAL COMPLEMENT AFTER FIND_BADS_EOG
# %%===========================================================================
EOG_Components = [] # TO FILL
MANUAL_EXCLUDE_AFTER_EOG = [] # TO FILL

InvalidManualExcludeAfterEOG = [
    idx for idx in MANUAL_EXCLUDE_AFTER_EOG
    if idx < 0 or idx >= ICA_3.n_components_
]
if len(InvalidManualExcludeAfterEOG) > 0:
    raise ValueError(
        f"Invalid ICA indices in MANUAL_EXCLUDE_AFTER_EOG: {InvalidManualExcludeAfterEOG}"
    )

FinalExcludeICA3 = sorted(list(set(EOG_Components + MANUAL_EXCLUDE_AFTER_EOG)))
ICA_3.exclude = FinalExcludeICA3

print("Final exclusions on ICA #3:", ICA_3.exclude)

if len(FinalExcludeICA3) > 0:
    FigExcludedStep3 = ICA_3.plot_components(
        picks=FinalExcludeICA3,
        show=False
    )
    if isinstance(FigExcludedStep3, list):
