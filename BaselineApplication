import mne
# =============================================================================

# =============================================================================
# PATHS
# %%===========================================================================
print("I define the path")
Subject = "SubjectID"
FolderPath = f"Path/{Subject}"
# =============================================================================

# =============================================================================
# DATA LOADING
# %%===========================================================================
print("I load the data")
Epochs = mne.read_epochs(FolderPath + "/{}_PreBaseline_final_cleaned-epo.fif".format(Subject), preload=True)
Epochs.info
# =============================================================================

# =============================================================================
# BASELINE CORRECTION
# %%===========================================================================
Baseline = (-0.2, 0.0)
print("I do the baseline correction")

Epochs_5 = Epochs["Stimulus/S  5"] # Generic
Epochs_5_Baselined = Epochs_5.apply_baseline(Baseline) 
Epochs_10 = Epochs["Stimulus/S 10"] # Neutral
Epochs_10_Baselined = Epochs_10.apply_baseline(Baseline)
Epochs_14 = Epochs["Stimulus/S 14"] # Personalized
Epochs_14_Baselined = Epochs_14.apply_baseline(Baseline)
# =============================================================================

# =============================================================================
# SAVING PATHS
# %%===========================================================================
print("I define the path where I save the preprocessed epochs")
Epoched_5_Baselined_File = FolderPath + "/{}_Stim5_200MSBaselined".format(Subject) + Subject + "-epo.fif"
Epoched_10_Baselined_File = FolderPath + "/{}_Stim10_200MSBaselined".format(Subject) + Subject + "-epo.fif"
Epoched_14_Baselined_File = FolderPath + "/{}_Stim14_200MSBaselined".format(Subject) + Subject + "-epo.fif"
# =============================================================================

# =============================================================================
# EPOCHS SAVING
# %%===========================================================================
print("I save the preprocessed epochs")
Epochs_5_Baselined.save(fname = Epoched_5_Baselined_File, overwrite = False)
Epochs_10_Baselined.save(fname = Epoched_10_Baselined_File, overwrite = False)
Epochs_14_Baselined.save(fname = Epoched_14_Baselined_File, overwrite = False)
# =============================================================================

# =============================================================================
# EPOCHS LOADING
# %%===========================================================================
print("I load the preprocessed epochs")
PreprocessedEpoched_5_Baselined = mne.read_epochs(Epoched_5_Baselined_File, proj = True, preload = True, verbose = None)
PreprocessedEpoched_10_Baselined = mne.read_epochs(Epoched_10_Baselined_File, proj = True, preload = True, verbose = None)
PreprocessedEpoched_14_Baselined = mne.read_epochs(Epoched_14_Baselined_File, proj = True, preload = True, verbose = None)
# =============================================================================

# =============================================================================
# EVOKEDS PATHS
# %%===========================================================================
print("I define the path where I will sage the evoked data")
PreprocessedEvoked_5_Baselined_Averaged_List_File = FolderPath + "/{}_Stim5_200MSBaselined".format(Subject) + Subject + "-ave.fif"
PreprocessedEvoked_10_Baselined_Averaged_List_File = FolderPath + "/{}_Stim10_200MSBaselined".format(Subject) + Subject + "-ave.fif"
PreprocessedEvoked_14_Baselined_Averaged_List_File = FolderPath + "/{}_Stim14_200MSBaselined".format(Subject) + Subject + "-ave.fif"
# =============================================================================

# =============================================================================
# EVOKING
# %%===========================================================================
print("I evoke the epochs")
PreprocessedEvoked_5_Baselined_Averaged = PreprocessedEpoched_5_Baselined.average() 
PreprocessedEvoked_10_Baselined_Averaged = PreprocessedEpoched_10_Baselined.average() 
PreprocessedEvoked_14_Baselined_Averaged = PreprocessedEpoched_14_Baselined.average()
# =============================================================================

# =============================================================================
# EVOKEDS SAVING
# %%===========================================================================
print("I save the evoked data")
